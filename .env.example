# 复制成 .env 后填写。.env 已被 .gitignore 忽略，绝不要提交。

# 必需：DeepSeek API 密钥 —— https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# 可选：模型名（默认 deepseek-flash，不要改成 deepseek-chat，发图会 400）
DEEPSEEK_MODEL=deepseek-flash

# 可选：语音合成服务（默认 edge = edge-tts 免费方案）
TTS_PROVIDER=edge

# 可选：接口地址（一般不用改）
DEEPSEEK_BASE=https://api.deepseek.com/v1

# 仅本地推送到 GitHub 时用，这三个不要配到服务器
# GITHUB_USER=
# GITHUB_PAT=
# REPO_NAME=aura-companion
